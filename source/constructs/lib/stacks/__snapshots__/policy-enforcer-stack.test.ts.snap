// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`CloudFormation template matches snapshot 1`] = `
{
  "Outputs": {
    "IamHelperLambdaName": {
      "Description": "Name of the out-of-VPC IAM Helper Lambda the API Lambda must invoke for IAM policy mutations.",
      "Export": {
        "Name": "CapabilityInsightsIamHelperLambdaName",
      },
      "Value": "CapabilityInsightsPolicyEnforcerIamHelper",
    },
    "PolicyRefreshLambdaName": {
      "Description": "Name of the in-VPC bulk refresh Lambda. The API Lambda invokes it for POST /policies/refresh-all.",
      "Export": {
        "Name": "CapabilityInsightsPolicyRefreshLambdaName",
      },
      "Value": "CapabilityInsightsPolicyEnforcerBulkRefresh",
    },
    "PolicyTableArn": {
      "Description": "ARN of the Policy_Configuration DynamoDB table.",
      "Export": {
        "Name": "CapabilityInsightsPolicyTableArn",
      },
      "Value": {
        "Fn::GetAtt": [
          "PolicyConfigurationTable",
          "Arn",
        ],
      },
    },
    "PolicyTableName": {
      "Description": "Name of the Policy_Configuration DynamoDB table.",
      "Export": {
        "Name": "CapabilityInsightsPolicyTableName",
      },
      "Value": "CapabilityInsightsPolicyConfiguration",
    },
  },
  "Parameters": {
    "BackendSubnetId": {
      "Description": "Subnet (no internet gateway) for the bulk policy-refresh Lambda. Must reach DynamoDB and S3 via gateway endpoints.",
      "Type": "AWS::EC2::Subnet::Id",
    },
    "BootstrapVersion": {
      "Default": "/cdk-bootstrap/hnb659fds/version",
      "Description": "Version of the CDK Bootstrap resources in this environment, automatically retrieved from SSM Parameter Store. [cdk:skip]",
      "Type": "AWS::SSM::Parameter::Value<String>",
    },
    "DeploymentAssetsBucketName": {
      "Description": "Name of S3 bucket where deployment assets (Lambda code zip) are located.",
      "Type": "String",
    },
    "LambdaCodeZipPath": {
      "Default": "lambdaAssets.zip",
      "Description": "Path in the deployment assets bucket where the Lambda code zip is located.",
      "Type": "String",
    },
    "PrivateVpcId": {
      "Description": "VPC where the in-VPC bulk policy-refresh Lambda runs.",
      "Type": "AWS::EC2::VPC::Id",
    },
    "WebsiteBucketName": {
      "Description": "Website bucket the bulk refresh Lambda reads the catalog (apis.json) from.",
      "Type": "String",
    },
  },
  "Resources": {
    "CapabilityInsightsPolicyEnforcerBulkRefresh": {
      "Properties": {
        "Code": {
          "S3Bucket": {
            "Ref": "DeploymentAssetsBucketName",
          },
          "S3Key": {
            "Ref": "LambdaCodeZipPath",
          },
        },
        "Environment": {
          "Variables": {
            "IAM_HELPER_LAMBDA_NAME": "CapabilityInsightsPolicyEnforcerIamHelper",
            "POLICY_TABLE_NAME": "CapabilityInsightsPolicyConfiguration",
            "WEBSITE_BUCKET_NAME": {
              "Ref": "WebsiteBucketName",
            },
          },
        },
        "FunctionName": "CapabilityInsightsPolicyEnforcerBulkRefresh",
        "Handler": "policy-refresh-lambda-main.handler",
        "MemorySize": 512,
        "Role": {
          "Fn::GetAtt": [
            "CapabilityInsightsPolicyEnforcerBulkRefreshRole",
            "Arn",
          ],
        },
        "Runtime": "nodejs24.x",
        "Timeout": 900,
        "VpcConfig": {
          "SecurityGroupIds": [
            {
              "Fn::GetAtt": [
                "CapabilityInsightsPolicyEnforcerBulkRefreshSG",
                "GroupId",
              ],
            },
          ],
          "SubnetIds": [
            {
              "Ref": "BackendSubnetId",
            },
          ],
        },
      },
      "Type": "AWS::Lambda::Function",
    },
    "CapabilityInsightsPolicyEnforcerBulkRefreshInvokePermission": {
      "Properties": {
        "Action": "lambda:InvokeFunction",
        "FunctionName": "CapabilityInsightsPolicyEnforcerBulkRefresh",
        "Principal": "events.amazonaws.com",
        "SourceArn": {
          "Fn::GetAtt": [
            "CapabilityInsightsPolicyEnforcerBulkRefreshWeeklyRule",
            "Arn",
          ],
        },
      },
      "Type": "AWS::Lambda::Permission",
    },
    "CapabilityInsightsPolicyEnforcerBulkRefreshRole": {
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Statement": [
            {
              "Action": "sts:AssumeRole",
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com",
              },
            },
          ],
          "Version": "2012-10-17",
        },
        "Description": "Execution role for the Policy Enforcer bulk refresh Lambda.",
        "ManagedPolicyArns": [
          {
            "Fn::Join": [
              "",
              [
                "arn:",
                {
                  "Ref": "AWS::Partition",
                },
                ":iam::aws:policy/service-role/AWSLambdaVPCAccessExecutionRole",
              ],
            ],
          },
        ],
        "Policies": [
          {
            "PolicyDocument": {
              "Statement": [
                {
                  "Action": [
                    "dynamodb:GetItem",
                    "dynamodb:PutItem",
                    "dynamodb:UpdateItem",
                    "dynamodb:Query",
                  ],
                  "Effect": "Allow",
                  "Resource": {
                    "Fn::GetAtt": [
                      "PolicyConfigurationTable",
                      "Arn",
                    ],
                  },
                },
                {
                  "Action": "s3:GetObject",
                  "Effect": "Allow",
                  "Resource": {
                    "Fn::Sub": [
                      "arn:\${AWS::Partition}:s3:::\${WebsiteBucket}/*",
                      {
                        "WebsiteBucket": {
                          "Ref": "WebsiteBucketName",
                        },
                      },
                    ],
                  },
                },
                {
                  "Action": "lambda:InvokeFunction",
                  "Effect": "Allow",
                  "Resource": {
                    "Fn::Sub": "arn:\${AWS::Partition}:lambda:\${AWS::Region}:\${AWS::AccountId}:function:CapabilityInsightsPolicyEnforcerIamHelper",
                  },
                },
                {
                  "Action": "sts:GetCallerIdentity",
                  "Effect": "Allow",
                  "Resource": "*",
                },
              ],
              "Version": "2012-10-17",
            },
            "PolicyName": "BulkRefreshAccess",
          },
        ],
        "RoleName": {
          "Fn::Sub": "CapabilityInsightsPolicyEnforcerBulkRefreshRole-\${AWS::Region}",
        },
      },
      "Type": "AWS::IAM::Role",
    },
    "CapabilityInsightsPolicyEnforcerBulkRefreshSG": {
      "Properties": {
        "GroupDescription": "Security group for the Policy Enforcer bulk refresh Lambda.",
        "SecurityGroupEgress": [
          {
            "CidrIp": "0.0.0.0/0",
            "Description": "Allow all outbound (S3/DynamoDB gateway endpoints, Lambda VPC endpoint).",
            "IpProtocol": "-1",
          },
        ],
        "VpcId": {
          "Ref": "PrivateVpcId",
        },
      },
      "Type": "AWS::EC2::SecurityGroup",
    },
    "CapabilityInsightsPolicyEnforcerBulkRefreshWeeklyRule": {
      "Properties": {
        "Description": "Weekly bulk refresh of all Policy Enforcer policies against the latest catalog.",
        "ScheduleExpression": "rate(7 days)",
        "State": "ENABLED",
        "Targets": [
          {
            "Arn": {
              "Fn::GetAtt": [
                "CapabilityInsightsPolicyEnforcerBulkRefresh",
                "Arn",
              ],
            },
            "Id": "PolicyEnforcerBulkRefreshTarget",
          },
        ],
      },
      "Type": "AWS::Events::Rule",
    },
    "CapabilityInsightsPolicyEnforcerIamHelper": {
      "Properties": {
        "Code": {
          "S3Bucket": {
            "Ref": "DeploymentAssetsBucketName",
          },
          "S3Key": {
            "Ref": "LambdaCodeZipPath",
          },
        },
        "FunctionName": "CapabilityInsightsPolicyEnforcerIamHelper",
        "Handler": "policy-enforcer-iam-helper.handler",
        "MemorySize": 256,
        "Role": {
          "Fn::GetAtt": [
            "CapabilityInsightsPolicyEnforcerIamHelperRole",
            "Arn",
          ],
        },
        "Runtime": "nodejs24.x",
        "Timeout": 60,
      },
      "Type": "AWS::Lambda::Function",
    },
    "CapabilityInsightsPolicyEnforcerIamHelperRole": {
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Statement": [
            {
              "Action": "sts:AssumeRole",
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com",
              },
            },
          ],
          "Version": "2012-10-17",
        },
        "Description": "Execution role for the Policy Enforcer IAM Helper Lambda. Scoped to PolicyEnforcer-* managed policies only.",
        "ManagedPolicyArns": [
          {
            "Fn::Join": [
              "",
              [
                "arn:",
                {
                  "Ref": "AWS::Partition",
                },
                ":iam::aws:policy/service-role/AWSLambdaBasicExecutionRole",
              ],
            ],
          },
        ],
        "Policies": [
          {
            "PolicyDocument": {
              "Statement": [
                {
                  "Action": [
                    "iam:CreatePolicy",
                    "iam:CreatePolicyVersion",
                    "iam:DeletePolicy",
                    "iam:DeletePolicyVersion",
                    "iam:GetPolicy",
                    "iam:GetPolicyVersion",
                    "iam:ListPolicyVersions",
                  ],
                  "Effect": "Allow",
                  "Resource": {
                    "Fn::Sub": "arn:\${AWS::Partition}:iam::\${AWS::AccountId}:policy/PolicyEnforcer-*",
                  },
                },
                {
                  "Action": "sts:GetCallerIdentity",
                  "Effect": "Allow",
                  "Resource": "*",
                },
              ],
              "Version": "2012-10-17",
            },
            "PolicyName": "PolicyEnforcerIamManagement",
          },
        ],
        "RoleName": {
          "Fn::Sub": "CapabilityInsightsPolicyEnforcerIamHelperRole-\${AWS::Region}",
        },
      },
      "Type": "AWS::IAM::Role",
    },
    "PolicyConfigurationTable": {
      "DeletionPolicy": "Delete",
      "Properties": {
        "AttributeDefinitions": [
          {
            "AttributeName": "accountId",
            "AttributeType": "S",
          },
          {
            "AttributeName": "policyName",
            "AttributeType": "S",
          },
        ],
        "BillingMode": "PAY_PER_REQUEST",
        "KeySchema": [
          {
            "AttributeName": "accountId",
            "KeyType": "HASH",
          },
          {
            "AttributeName": "policyName",
            "KeyType": "RANGE",
          },
        ],
        "PointInTimeRecoverySpecification": {
          "PointInTimeRecoveryEnabled": true,
        },
        "SSESpecification": {
          "SSEEnabled": true,
        },
        "TableName": "CapabilityInsightsPolicyConfiguration",
      },
      "Type": "AWS::DynamoDB::Table",
      "UpdateReplacePolicy": "Delete",
    },
  },
  "Rules": {
    "CheckBootstrapVersion": {
      "Assertions": [
        {
          "Assert": {
            "Fn::Not": [
              {
                "Fn::Contains": [
                  [
                    "1",
                    "2",
                    "3",
                    "4",
                    "5",
                  ],
                  {
                    "Ref": "BootstrapVersion",
                  },
                ],
              },
            ],
          },
          "AssertDescription": "CDK bootstrap stack version 6 required. Please run 'cdk bootstrap' with a recent version of the CDK CLI.",
        },
      ],
    },
  },
}
`;
